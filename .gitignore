# Зависимости Node.js (на шаге 1.1 их нет, каталог появится позже)
node_modules/

# Секреты: переменные окружения и ключи
.env
*.env
*.key
*.pem

# Логи
*.log

# Служебные файлы ОС
.DS_Store
Thumbs.db

# Временные файлы Excel (~$книга.xlsx)
~$*

# Любые книги Excel с реальными данными.
# В репозитории разрешён только шаблон без данных: excel/template/
excel/**/*.xlsx
excel/**/*.xlsm
!excel/template/**

# Рабочие каталоги, в которые попадают выгрузки и промежуточные файлы
output/
tmp/
secrets/
